      "events": [
        {
          "type": "BuiltinCommonInstructions::Comment",
          "color": {
            "b": 51,
            "g": 107,
            "r": 250,
            "textB": 255,
            "textG": 255,
            "textR": 255
          },
          "comment": "This project is meant as a game example or template for a more advanced platformer. This is in the style of older castlevania entries, such as Castlevania 1 or 3.\nThere are numerous advanced GDevelop concepts in this project, such as finite state machines (FSMs), tweens, bitmap fonts and bitmap text objects, tilemaps, external event sheets, declaring variables via events, and object variables. \n\nBefore working with this project, it is STRONGLY recommended that you review the following:\nAt least the first four tutorials on the GDevelop Wiki: http://wiki.compilgames.net/doku.php/gdevelop5/tutorials. This example uses concepts from EACH of those tutorials and it is important to understand those concepts before trying to adapt these ideas.\nThe finite state machine tutorial at: http://wiki.compilgames.net/doku.php/gdevelop5/tutorials/finite_state_machine"
        },
        {
          "type": "BuiltinCommonInstructions::Comment",
          "color": {
            "b": 109,
            "g": 230,
            "r": 255,
            "textB": 0,
            "textG": 0,
            "textR": 0
          },
          "comment": "The following events help with some of the aesthetics of the title screen by centering the title screen and menu item text on the X axis.\nThe Menu Border object is then centered based off the middle menu item.\nFinally, the Menu Selector object is centered and placed over the Start Game object.\nWe also use this event to play the title music."
        },
        {
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [
            {
              "type": {
                "value": "SceneJustBegins"
              },
              "parameters": [
                ""
              ]
            }
          ],
          "actions": [
            {
              "type": {
                "value": "SetCenterX"
              },
              "parameters": [
                "MenuTextItem",
                "=",
                "SceneWindowWidth()/2"
              ]
            },
            {
              "type": {
                "value": "SetCenterX"
              },
              "parameters": [
                "BitmapTitle",
                "=",
                "SceneWindowWidth()/2"
              ]
            },
            {
              "type": {
                "value": "SetXY"
              },
              "parameters": [
                "MenuBorder",
                "=",
                "BitmapMenuStart.CenterX() - (MenuBorder.Width() / 2)",
                "=",
                "BitmapMenuCredits.CenterY()-(MenuBorder.Height()/2)"
              ]
            },
            {
              "type": {
                "value": "SetXY"
              },
              "parameters": [
                "MenuSelector",
                "=",
                "BitmapMenuStart.CenterX()-(MenuSelector.Width()/2)",
                "=",
                "BitmapMenuStart.CenterY()-(MenuSelector.Height()/2)"
              ]
            },
            {
              "type": {
                "value": "PlaySoundOnChannel"
              },
              "parameters": [
                "",
                "Jonathan_So-ForMe-truncade.ogg",
                "100",
                "yes",
                "100",
                ""
              ]
            },
            {
              "type": {
                "value": "SetY"
              },
              "parameters": [
                "GamepadControls",
                "=",
                "KeyboardControls.Y()"
              ]
            },
            {
              "type": {
                "value": "SetCenterX"
              },
              "parameters": [
                "JumpAttack",
                "=",
                "SceneWindowWidth()/2"
              ]
            }
          ],
          "events": [
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "Opacity"
                  },
                  "parameters": [
                    "FadeObject",
                    "=",
                    "0"
                  ]
                },
                {
                  "type": {
                    "value": "SetXY"
                  },
                  "parameters": [
                    "FadeObject",
                    "=",
                    "0",
                    "=",
                    "0"
                  ]
                },
                {
                  "type": {
                    "value": "ResizableCapability::ResizableBehavior::SetWidth"
                  },
                  "parameters": [
                    "FadeObject",
                    "Resizable",
                    "=",
                    "CameraWidth(\"\",0)"
                  ]
                },
                {
                  "type": {
                    "value": "ResizableCapability::ResizableBehavior::SetHeight"
                  },
                  "parameters": [
                    "FadeObject",
                    "Resizable",
                    "=",
                    "CameraHeight(\"\",0)"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "GameState.Checkpoint",
                    "=",
                    "0"
