                },
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "GameState.Lives",
                    "=",
                    "3"
                  ]
                }
              ]
            }
          ]
        },
        {
          "colorB": 228,
          "colorG": 176,
          "colorR": 74,
          "creationTime": 0,
          "name": "Menu Events",
          "source": "",
          "type": "BuiltinCommonInstructions::Group",
          "events": [
            {
              "colorB": 228,
              "colorG": 176,
              "colorR": 74,
              "creationTime": 0,
              "name": "Movement Events",
              "source": "",
              "type": "BuiltinCommonInstructions::Group",
              "events": [
                {
                  "type": "BuiltinCommonInstructions::Comment",
                  "color": {
                    "b": 109,
                    "g": 230,
                    "r": 255,
                    "textB": 0,
                    "textG": 0,
                    "textR": 0
                  },
                  "comment": "To ensure that menu selector only moves once when a movement key is pressed, a variable is used to restrict the ability to move at all after moving once. \nThis variable needs to be switched back once all movement buttons are not pressed, and this is accomplished by checking that it is currently restricted, then checking that no buttons are pressed, then switching it back."
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "NumberVariable"
                      },
                      "parameters": [
                        "SelectorButtonsReleased",
                        "=",
                        "0"
                      ]
                    },
                    {
                      "type": {
                        "inverted": true,
                        "value": "Gamepads::C_Button_pressed"
                      },
                      "parameters": [
                        "",
                        "1",
                        "gamepadUp",
                        ""
                      ]
                    },
                    {
                      "type": {
                        "inverted": true,
                        "value": "Gamepads::C_Button_pressed"
                      },
                      "parameters": [
                        "",
                        "1",
                        "gamepadDown",
                        ""
                      ]
                    },
                    {
                      "type": {
                        "inverted": true,
                        "value": "KeyFromTextPressed"
                      },
                      "parameters": [
                        "",
                        "keyboardUp"
                      ]
                    },
                    {
                      "type": {
                        "inverted": true,
                        "value": "KeyFromTextPressed"
                      },
                      "parameters": [
                        "",
                        "keyboardDown"
                      ]
                    },
                    {
                      "type": {
                        "value": "BuiltinCommonInstructions::Once"
                      },
                      "parameters": []
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "SetNumberVariable"
                      },
                      "parameters": [
                        "SelectorButtonsReleased",
                        "=",
                        "1"
                      ]
                    }
                  ]
                },
                {
                  "type": "BuiltinCommonInstructions::Comment",
                  "color": {
                    "b": 109,
                    "g": 230,
                    "r": 255,
                    "textB": 0,
                    "textG": 0,
                    "textR": 0
                  },
                  "comment": "The events shouldn't occur unless the selector has been released since last press AND the fade out hasn't started."
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "NumberVariable"
                      },
                      "parameters": [
                        "SelectorButtonsReleased",
                        "=",
                        "1"
                      ]
                    },
                    {
                      "type": {
                        "value": "Opacity"
                      },
                      "parameters": [
                        "FadeObject",
                        "=",
                        "0"
                      ]
                    }
                  ],
                  "actions": [],
                  "events": [
                    {
                      "type": "BuiltinCommonInstructions::Comment",
                      "color": {
                        "b": 109,
                        "g": 230,
                        "r": 255,
                        "textB": 0,
                        "textG": 0,
                        "textR": 0
                      },
                      "comment": "Move the Selector Up or Down based off the gamepad button or keyboard key pressed.\nTo select the correct menu item to move to, the Up or Down variables are compared to the MenuTextItem group to find the matching Item.\nThe selector is then moved to the Y position of the correct MenuTextItem, -16 pixels to center the selector."
                    },
                    {
                      "type": "BuiltinCommonInstructions::Standard",
                      "conditions": [
                        {
                          "type": {
                            "value": "BuiltinCommonInstructions::Or"
                          },
                          "parameters": [],
                          "subInstructions": [
                            {
                              "type": {
                                "value": "Gamepads::C_Button_pressed"
                              },
                              "parameters": [
                                "",
                                "1",
                                "gamepadUp",
                                ""
                              ]
                            },
                            {
                              "type": {
                                "value": "KeyFromTextPressed"
                              },
                              "parameters": [
                                "",
                                "keyboardUp"
                              ]
                            }
                          ]
                        },
                        {
                          "type": {
                            "value": "StringObjectVariable"
                          },
                          "parameters": [
                            "MenuTextItem",
                            "ID",
                            "=",
                            "CurrentMenuItem.Up"
                          ]
                        },
                        {
                          "type": {
                            "value": "BuiltinCommonInstructions::Once"
                          },
                          "parameters": []
                        }
                      ],
                      "actions": [
                        {
                          "type": {
                            "value": "SetY"
                          },
                          "parameters": [
                            "MenuSelector",
                            "=",
                            "MenuTextItem.Y()-16"
                          ]
                        },
                        {
                          "type": {
                            "value": "SetNumberVariable"
                          },
                          "parameters": [
                            "SelectorButtonsReleased",
                            "=",
                            "0"
                          ]
                        },
                        {
                          "type": {
                            "value": "PlaySoundOnChannel"
                          },
                          "parameters": [
                            "",
                            "MenuMove.wav",
                            "1",
                            "",
                            "60",
                            "1"
                          ]
                        }
                      ]
                    },
                    {
                      "type": "BuiltinCommonInstructions::Standard",
                      "conditions": [
                        {
                          "type": {
                            "value": "BuiltinCommonInstructions::Or"
                          },
                          "parameters": [],
                          "subInstructions": [
                            {
                              "type": {
                                "value": "Gamepads::C_Button_pressed"
                              },
                              "parameters": [
                                "",
                                "1",
                                "gamepadDown",
                                ""
                              ]
                            },
                            {
                              "type": {
                                "value": "KeyFromTextPressed"
                              },
                              "parameters": [
                                "",
                                "keyboardDown"
                              ]
                            }
                          ]
                        },
                        {
                          "type": {
                            "value": "StringObjectVariable"
                          },
                          "parameters": [
                            "MenuTextItem",
                            "ID",
                            "=",
                            "CurrentMenuItem.Down"
                          ]
                        },
                        {
                          "type": {
                            "value": "BuiltinCommonInstructions::Once"
                          },
                          "parameters": []
                        }
                      ],
                      "actions": [
                        {
                          "type": {
                            "value": "SetY"
                          },
                          "parameters": [
                            "MenuSelector",
                            "=",
                            "MenuTextItem.Y()-16"
                          ]
                        },
                        {
                          "type": {
                            "value": "SetNumberVariable"
                          },
                          "parameters": [
                            "SelectorButtonsReleased",
                            "=",
                            "0"
                          ]
                        },
                        {
                          "type": {
                            "value": "PlaySoundOnChannel"
                          },
                          "parameters": [
                            "",
                            "MenuMove.wav",
                            "1",
                            "",
                            "60",
                            "1"
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "BuiltinCommonInstructions::Comment",
                  "color": {
                    "b": 109,
                    "g": 230,
                    "r": 255,
                    "textB": 0,
                    "textG": 0,
                    "textR": 0
                  },
                  "comment": "Once the selector is not moving, and the movement buttons are released, the scene variables tracking the current ID and possible movement IDs are updated."
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "NumberVariable"
                      },
                      "parameters": [
                        "SelectorButtonsReleased",
                        "=",
                        "1"
                      ]
                    },
                    {
                      "type": {
                        "value": "CollisionNP"
                      },
                      "parameters": [
                        "MenuSelector",
                        "MenuTextItem",
                        "",
                        "",
                        ""
                      ]
                    },
                    {
                      "type": {
                        "value": "BuiltinCommonInstructions::Once"
                      },
                      "parameters": []
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "SetStringVariable"
                      },
                      "parameters": [
                        "CurrentMenuItem.ID",
                        "=",
                        "MenuTextItem.ID"
                      ]
                    },
                    {
                      "type": {
                        "value": "SetStringVariable"
                      },
                      "parameters": [
                        "CurrentMenuItem.Up",
                        "=",
                        "MenuTextItem.Up"
                      ]
                    },
                    {
                      "type": {
                        "value": "SetStringVariable"
                      },
                      "parameters": [
                        "CurrentMenuItem.Down",
                        "=",
                        "MenuTextItem.Down"
                      ]
                    }
                  ]
                }
              ],
              "parameters": []
            },
            {
              "colorB": 228,
              "colorG": 176,
              "colorR": 74,
              "creationTime": 0,
              "name": "Selection Events",
              "source": "",
              "type": "BuiltinCommonInstructions::Group",
              "events": [
                {
                  "type": "BuiltinCommonInstructions::Comment",
                  "color": {
                    "b": 109,
                    "g": 230,
                    "r": 255,
                    "textB": 0,
                    "textG": 0,
                    "textR": 0
                  },
                  "comment": "As the screen should fade out once an object is selected, these events check that the movement has been completed, then starts the opacity tween of the Fade Object.\nAlso play the select sound once."
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "NumberVariable"
                      },
                      "parameters": [
                        "SelectorButtonsReleased",
                        "=",
                        "1"
                      ]
                    },
                    {
                      "type": {
                        "value": "Opacity"
                      },
                      "parameters": [
                        "FadeObject",
                        "=",
                        "0"
                      ]
                    },
                    {
                      "type": {
                        "value": "BuiltinCommonInstructions::Or"
                      },
                      "parameters": [],
                      "subInstructions": [
                        {
                          "type": {
                            "value": "Gamepads::C_Button_pressed"
                          },
                          "parameters": [
                            "",
                            "1",
                            "gamepadJump",
                            ""
                          ]
                        },
                        {
                          "type": {
                            "value": "KeyFromTextPressed"
                          },
                          "parameters": [
                            "",
                            "keyboardAttack"
                          ]
                        }
                      ]
                    },
                    {
                      "type": {
                        "value": "BuiltinCommonInstructions::Once"
                      },
                      "parameters": []
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "Tween::AddObjectOpacityTween"
                      },
                      "parameters": [
                        "FadeObject",
                        "Tween",
                        "\"FadeOut\"",
                        "255",
                        "\"linear\"",
                        "500",
                        ""
                      ]
                    },
                    {
                      "type": {
                        "value": "PlaySoundOnChannel"
                      },
                      "parameters": [
                        "",
                        "Select.wav",
                        "1",
                        "",
                        "50",
                        "1"
                      ]
                    }
                  ]
                },
                {
                  "type": "BuiltinCommonInstructions::Comment",
                  "color": {
                    "b": 109,
                    "g": 230,
                    "r": 255,
                    "textB": 0,
                    "textG": 0,
                    "textR": 0
                  },
                  "comment": "Once the fade out has finished, collision is tested between the selector and Menu Text Item, to find out which action is currently selected.\nThe action listed is then used to decide which scene to change to."
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "Tween::HasFinished"
                      },
                      "parameters": [
                        "FadeObject",
                        "Tween",
                        "\"FadeOut\""
                      ]
                    },
                    {
                      "type": {
                        "value": "CollisionNP"
                      },
                      "parameters": [
                        "MenuSelector",
                        "MenuTextItem",
                        "",
                        "",
                        ""
                      ]
                    },
                    {
                      "type": {
                        "value": "BuiltinCommonInstructions::Once"
                      },
                      "parameters": []
                    }
                  ],
                  "actions": [],
                  "events": [
                    {
                      "type": "BuiltinCommonInstructions::Standard",
                      "conditions": [
                        {
                          "type": {
                            "value": "StringObjectVariable"
                          },
                          "parameters": [
                            "MenuTextItem",
                            "Action",
                            "=",
                            "\"Start\""