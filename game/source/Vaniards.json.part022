                      },
                      "parameters": [
                        "",
                        "=",
                        "round(CameraX(\"\",0)*0.06)",
                        "\"BG1\"",
                        "0"
                      ]
                    },
                    {
                      "type": {
                        "value": "SetCameraCenterX"
                      },
                      "parameters": [
                        "",
                        "=",
                        "round(CameraX(\"\",0)*0.02)",
                        "\"BG2\"",
                        "0"
                      ]
                    },
                    {
                      "type": {
                        "value": "SetCameraCenterY"
                      },
                      "parameters": [
                        "",
                        "=",
                        "floor(CameraY(\"\",0)*0.025)",
                        "\"BG1\"",
                        "0"
                      ]
                    }
                  ]
                },
                {
                  "type": "BuiltinCommonInstructions::Comment",
                  "color": {
                    "b": 109,
                    "g": 230,
                    "r": 255,
                    "textB": 0,
                    "textG": 0,
                    "textR": 0
                  },
                  "comment": "When not in collision with the BossRoom, the main, dash effect, and death effect layer cameras should follow the HeroHitbox object.\nThe CutsceneCamera object should stay centered on the HeroHitbox so its starting point feels \"normal\" when the game switches to following it."
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "inverted": true,
                        "value": "CollisionNP"
                      },
                      "parameters": [
                        "HeroHitbox",
                        "BossRoom",
                        "",
                        "",
                        ""
                      ]
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "FixCamera"
                      },
                      "parameters": [
                        "",
                        "HeroHitbox",
                        "CameraRoom.X()",
                        "CameraRoom.Y()",
                        "CameraRoom.X() + CameraRoom.Width()",
                        "CameraRoom.Y() + CameraRoom.Height()",
                        "yes",
                        "\"\"",
                        "0"
                      ]
                    },
                    {
                      "type": {
                        "value": "FixCamera"
                      },
                      "parameters": [
                        "",
                        "HeroHitbox",
                        "CameraRoom.X()",
                        "CameraRoom.Y()",
                        "CameraRoom.X() + CameraRoom.Width()",
                        "CameraRoom.Y() + CameraRoom.Height()",
                        "yes",
                        "\"DashEffect\"",
                        "0"
                      ]
                    },
                    {
                      "type": {
                        "value": "FixCamera"
                      },
                      "parameters": [
                        "",
                        "HeroHitbox",
                        "CameraRoom.X()",
                        "CameraRoom.Y()",
                        "CameraRoom.X() + CameraRoom.Width()",
                        "CameraRoom.Y() + CameraRoom.Height()",
                        "yes",
                        "\"DeathEffect\"",
                        "0"
                      ]
                    },
                    {
                      "type": {
                        "value": "SetXY"
                      },
                      "parameters": [
                        "CutsceneCamera",
                        "=",
                        "HeroHitbox.CenterX()-(CutsceneCamera.Width()/2)",
                        "=",
                        "HeroHitbox.CenterY()-(CutsceneCamera.Height()/2)"
                      ]
                    }
                  ]
                },
                {
                  "type": "BuiltinCommonInstructions::Comment",
                  "color": {
                    "b": 109,
                    "g": 230,
                    "r": 255,
                    "textB": 0,
                    "textG": 0,
                    "textR": 0
                  },
                  "comment": "Once in collision with the BossRoom, update the BossStart variable. This is used to trigger the Boss Start Cutscene."
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "NumberVariable"
                      },
                      "parameters": [
                        "BossStart",
                        "=",
                        "0"
                      ]
                    },
                    {
                      "type": {
                        "value": "CollisionNP"
                      },
                      "parameters": [
                        "HeroHitbox",
                        "BossRoom",
                        "",
                        "",
                        ""
                      ]
                    },
                    {
                      "type": {
                        "value": "BuiltinCommonInstructions::Once"
                      },
                      "parameters": []
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "SetNumberVariable"
                      },
                      "parameters": [
                        "BossStart",
                        "=",
                        "1"
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "parameters": []
        }
      ]
    },
    {
      "associatedLayout": "Stage",
      "name": "GUIManagement",
      "events": [
        {
          "colorB": 228,
          "colorG": 176,
          "colorR": 74,
          "creationTime": 0,
          "name": "Health Bar",
          "source": "",
          "type": "BuiltinCommonInstructions::Group",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "The health bar is created as a 9-patch/panel sprite object. This is so we can modify the width without modifying the appearance of the sprite.\nAt the beginning of the scene, get the default width of the Health Bar. This is stored as a variable so we can use this for calculations later."
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "SceneJustBegins"
                  },
                  "parameters": [
                    ""
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "SetNumberObjectVariable"
                  },
                  "parameters": [
                    "GUIHealthBar",
                    "DefaultWidth",
                    "=",
                    "GUIHealthBar.Width()"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "As the hero takes damage, we want to reduce the size of the health bar proportionally to the total percentage of HP vs Max HP. \nTo make it look more \"Pixel perfect\" and less smooth, we want it to only move in increments of what one pixel would be. \nAs the assets have been resized for 720p, one pixel is now 4 pixels. To get it to round to the nearest multiple of 4, we divide the updated width by 4, round the result down, then multiply by 4."
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "PanelSpriteObject::Width"
                  },
                  "parameters": [
                    "GUIHealthBar",
                    "=",
                    "floor(GUIHealthBar.DefaultWidth * Hero.heroHP / Hero.heroMaxHP / 4) * 4"
                  ]
                }
              ]
            }
          ],
          "parameters": []
        },
        {
          "colorB": 228,
          "colorG": 176,
          "colorR": 74,
          "creationTime": 0,
          "name": "Stamina Bar",
          "source": "",
          "type": "BuiltinCommonInstructions::Group",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "The stamina bar is handled identical to the health bar, but focuses on the current stamina vs max stamina of the hero."
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "SceneJustBegins"
                  },
                  "parameters": [
                    ""
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "SetNumberObjectVariable"
                  },
                  "parameters": [
                    "GUIStaminaBar",
                    "DefaultWidth",
                    "=",
                    "GUIStaminaBar.Width()"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "PanelSpriteObject::Width"
                  },
                  "parameters": [
                    "GUIStaminaBar",
                    "=",
                    "floor(GUIStaminaBar.DefaultWidth * Hero.heroStam / Hero.heroMaxStam / 4) * 4"
                  ]
                }
              ]
            }
          ],
          "parameters": []
        },
        {
          "colorB": 228,
          "colorG": 176,
          "colorR": 74,
          "creationTime": 0,
          "name": "Lives",
          "source": "",
          "type": "BuiltinCommonInstructions::Group",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "The Lives are displayed via a text object that, GUILivesLabel.\nThis text object is updated to the current amount of lives stored as a global variable."
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "VarGlobalTxt"
                  },
                  "parameters": [
                    "Language",
                    "=",
                    "\"en\""
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "BitmapText::BitmapTextObject::SetText"
                  },
                  "parameters": [
                    "GUIBitmapLives",
                    "=",
                    "\"LIVES: \" + GameState.Lives"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "VarGlobalTxt"
                  },
                  "parameters": [
                    "Language",
                    "=",
                    "\"es\""
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "BitmapText::BitmapTextObject::SetText"
                  },
                  "parameters": [
                    "GUIBitmapLives",
                    "=",
                    "\"VIDAS: \" + GameState.Lives"
                  ]
                }
              ]
            }
          ],
          "parameters": []
        }
      ]
    },
    {
      "associatedLayout": "Stage",
      "name": "HeroObjectManagement",
      "events": [
        {
          "colorB": 228,
          "colorG": 176,
          "colorR": 74,
          "creationTime": 0,
          "name": "Hero Hitbox Positioning",
          "source": "",
          "type": "BuiltinCommonInstructions::Group",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "These events position the hero sprite over the hitbox object.\nThe hitbox object is used to guarantee that the movement and positioning of the hero is consistent, regardless of the hero animation.\nIf the hero object was used for movement directly, if the animations had different sizes, the sprite would jump around on the floor when animations change."
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "SetXY"
                  },
                  "parameters": [
                    "Hero",
                    "=",
                    "HeroHitbox.X()",
                    "=",
                    "HeroHitbox.Y()"
                  ]
                }
              ]
            }
          ],
          "parameters": []
        },
        {
          "colorB": 228,
          "colorG": 176,
          "colorR": 74,
          "creationTime": 0,
          "name": "Attack Hitbox Positioning",
          "source": "",
          "type": "BuiltinCommonInstructions::Group",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "These events ensure the attack hotbox is positioned where it should be.\nActual attack collision and damage is dealt with in the enemy management events."
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "inverted": true,
                    "value": "FlippableCapability::FlippableBehavior::FlippedX"
                  },
                  "parameters": [
                    "Hero",
                    "Flippable"
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "SetXY"
                  },
                  "parameters": [
                    "HeroAttackHitbox",
                    "=",
                    "Hero.PointX(\"AttackOrigin\")",
                    "=",
                    "Hero.PointY(\"AttackOrigin\")"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "FlippableCapability::FlippableBehavior::FlippedX"
                  },
                  "parameters": [
                    "Hero",
                    "Flippable"
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "SetXY"
                  },
                  "parameters": [
                    "HeroAttackHitbox",
                    "=",
                    "Hero.PointX(\"AttackOrigin\") - HeroAttackHitbox.Width()",
                    "=",
                    "Hero.PointY(\"AttackOrigin\")"
                  ]
                }
              ]
            }
          ],
          "parameters": []
        }
      ]
    },
    {
      "associatedLayout": "Stage",
      "name": "DebugManagement",
      "events": [
        {
          "colorB": 228,
          "colorG": 176,
          "colorR": 74,
          "creationTime": 0,
          "name": "Debug Visibility",
          "source": "",
          "type": "BuiltinCommonInstructions::Group",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "These events set any items added to the debug group as hidden at the start of the scene, then changes their opacity.\nThis is useful for when there are game objects used for logic but shouldn't be displayed during normal gameplay."
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "SceneJustBegins"
                  },
                  "parameters": [
                    ""
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "Hide"
                  },
                  "parameters": [
                    "DebugGroup"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "The following events show, hide, and position the debug items, but ONLY if being runned in a preview. \nThis prevents these keys from working in the exported or final game."
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "SystemInfo::IsPreview"
                  },
                  "parameters": [
                    ""
                  ]
                }
              ],
              "actions": [],
              "events": [
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [],
                  "actions": [
                    {
                      "type": {
                        "value": "TextContainerCapability::TextContainerBehavior::SetValue"
                      },
                      "parameters": [
