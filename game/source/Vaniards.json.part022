    {
      "associatedLayout": "Stage",
      "name": "PatrollerEnemy",
      "events": [
        {
          "colorB": 228,
          "colorG": 176,
          "colorR": 74,
          "creationTime": 0,
          "name": "Patroller Enemy Logic",
          "source": "",
          "type": "BuiltinCommonInstructions::Group",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "Patroller movement should pause when \"hit stunned\". This is controled by the Enemy Combat Management events."
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "NumberObjectVariable"
                  },
                  "parameters": [
                    "PatrollerEnemy",
                    "HitStun",
                    "=",
                    "0"
                  ]
                }
              ],
              "actions": [],
              "events": [
                {
                  "type": "BuiltinCommonInstructions::Comment",
                  "color": {
                    "b": 109,
                    "g": 230,
                    "r": 255,
                    "textB": 0,
                    "textG": 0,
                    "textR": 0
                  },
                  "comment": "The patroller enemy has the platformer character behavior attached to it, with default controls disabled. This simplifies movement events.\nThe enemy should move based off the current direction in the object variable \"Direction\"."
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "StringObjectVariable"
                      },
                      "parameters": [
                        "PatrollerEnemy",
                        "Direction",
                        "=",
                        "\"Left\""
                      ]
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "PlatformBehavior::SimulateLeftKey"
                      },
                      "parameters": [
                        "PatrollerEnemy",
                        "PlatformerObject"
                      ]
                    }
                  ]
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "StringObjectVariable"
                      },
                      "parameters": [
                        "PatrollerEnemy",
                        "Direction",
                        "=",
                        "\"Right\""
                      ]
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "PlatformBehavior::SimulateRightKey"
                      },
                      "parameters": [
                        "PatrollerEnemy",
                        "PlatformerObject"
                      ]
                    }
                  ]
                },
                {
                  "type": "BuiltinCommonInstructions::Comment",
                  "color": {
                    "b": 109,
                    "g": 230,
                    "r": 255,
                    "textB": 0,
                    "textG": 0,
                    "textR": 0
                  },
                  "comment": "When in collision with a direction object, update the \"Direction\" variable."
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "CollisionNP"
                      },
                      "parameters": [
                        "PatrollerEnemy",
                        "Right",
                        "",
                        "",
                        ""
                      ]
                    },
                    {
                      "type": {
                        "value": "BuiltinCommonInstructions::Once"
                      },
                      "parameters": []
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "SetStringObjectVariable"
                      },
                      "parameters": [
                        "PatrollerEnemy",
                        "Direction",
                        "=",
                        "\"Right\""
                      ]
                    },
                    {
                      "type": {
                        "value": "FlippableCapability::FlippableBehavior::FlipX"
                      },
                      "parameters": [
                        "PatrollerEnemy",
                        "Flippable",
                        "yes"
                      ]
                    }
                  ]
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "CollisionNP"
                      },
                      "parameters": [
                        "PatrollerEnemy",
                        "Left",
                        "",
                        "",
                        ""
                      ]