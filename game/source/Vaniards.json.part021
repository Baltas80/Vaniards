    {
      "associatedLayout": "Stage",
      "name": "HeroFSMDeath",
      "events": [
        {
          "colorB": 228,
          "colorG": 176,
          "colorR": 74,
          "creationTime": 0,
          "name": "Action",
          "source": "",
          "type": "BuiltinCommonInstructions::Group",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "BuiltinCommonInstructions::Once"
                  },
                  "parameters": []
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "Opacity"
                  },
                  "parameters": [
                    "Hero",
                    "=",
                    "255"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "If the player has more than 0 lives:\nFade out the game music and then play the death music. This is to ensure there's not a sudden restart of the scene upon death.."
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "NumberVariable"
                  },
                  "parameters": [
                    "GameState.Lives",
                    ">",
                    "0"
                  ]
                }
              ],
              "actions": [],
              "events": [
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "SoundChannelVolume"
                      },
                      "parameters": [
                        "",
                        "100",
                        ">",
                        "0"
                      ]
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "SetSoundChannelVolume"
                      },
                      "parameters": [
                        "",
                        "100",
                        "=",
                        "clamp(SoundChannelVolume(100)-3,0,100)"
                      ]
                    }
                  ]
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "SoundChannelVolume"
                      },
                      "parameters": [
                        "",
                        "100",
                        "=",
                        "0"
                      ]
                    },
                    {
                      "type": {
                        "value": "BuiltinCommonInstructions::Once"
                      },
                      "parameters": []
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "PlaySoundOnChannel"
                      },
                      "parameters": [
                        "",
                        "Jonathan_So-MissionOver.ogg",
                        "0",
                        "",
                        "100",
                        "1"
                      ]
                    }
                  ],
                  "events": [
                    {
                      "type": "BuiltinCommonInstructions::Comment",
                      "color": {
                        "b": 109,
                        "g": 230,
                        "r": 255,
                        "textB": 0,
                        "textG": 0,
                        "textR": 0
                      },
                      "comment": "If the player fell into a pit, delete the HeroHitbox to stop the camera, then hide the hero sprite."
                    },
                    {
                      "type": "BuiltinCommonInstructions::Standard",
                      "conditions": [
                        {
                          "type": {
                            "value": "CollisionNP"
                          },
                          "parameters": [
                            "Hero",
                            "DeathPit",
                            "",
                            "",
                            ""
                          ]
                        }
                      ],
                      "actions": [
                        {
                          "type": {
                            "value": "ActivateBehavior"
                          },
                          "parameters": [
                            "HeroHitbox",
                            "PlatformerObject",
                            "no"
                          ]
                        },
                        {
                          "type": {
                            "value": "Delete"
                          },
                          "parameters": [
                            "HeroHitbox",
                            ""
                          ]
                        },
                        {
                          "type": {
                            "value": "Hide"
                          },
                          "parameters": [
                            "Hero"
                          ]
                        }
                      ]
                    },
                    {
                      "type": "BuiltinCommonInstructions::Comment",
                      "color": {
                        "b": 109,
                        "g": 230,
                        "r": 255,
                        "textB": 0,
                        "textG": 0,
                        "textR": 0
                      },
                      "comment": "If the player did not fall into a pit, move the hero sprite to the DeathEffect layer, this is to give a visual indication of death."
                    },
                    {
                      "type": "BuiltinCommonInstructions::Standard",
                      "conditions": [
                        {
                          "type": {
                            "inverted": true,
                            "value": "CollisionNP"
                          },
                          "parameters": [
                            "Hero",
                            "DeathPit",
                            "",
                            "",
                            ""
                          ]
                        }
                      ],
                      "actions": [
                        {
                          "type": {
                            "value": "ChangeLayer"
                          },
                          "parameters": [
                            "Hero",
                            "\"DeathEffect\""
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "BuiltinCommonInstructions::Comment",
                  "color": {
                    "b": 109,
                    "g": 230,
                    "r": 255,
                    "textB": 0,
                    "textG": 0,
                    "textR": 0
                  },
                  "comment": "Once the player has died, start fading the color scale of the hero sprite to black and white.\nAdding TimeDelta() to the variable allows for different framerates to behave relatively the same, allowing for a smooth transition."
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [],
                  "actions": [
                    {
                      "type": {
                        "value": "SetNumberVariable"
                      },
                      "parameters": [
                        "BW",
                        "+",
                        "TimeDelta()"
                      ]
                    },
                    {
                      "type": {
                        "value": "SetLayerEffectParameter"
                      },
                      "parameters": [
                        "",
                        "\"DeathEffect\"",
                        "\"BW\"",
                        "\"opacity\"",
                        "clamp(BW, 0, 1)"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "If the player has 0 lives, this needs to be treated as a game over."
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "NumberVariable"
                  },
                  "parameters": [
                    "GameState.Lives",
                    "=",
                    "0"
                  ]
                }
              ],
              "actions": [],
              "events": [
                {
                  "type": "BuiltinCommonInstructions::Comment",
                  "color": {
                    "b": 109,
                    "g": 230,
                    "r": 255,
                    "textB": 0,
                    "textG": 0,
                    "textR": 0
                  },
                  "comment": "A game over should be treated differently than normal player death.\nPlay the gameover music then set the opacity of both the FadeObject sprite and GameOver text to 0, so they are not visible when they are unhidden."
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "SoundChannelVolume"
                      },
                      "parameters": [
                        "",
                        "100",
                        ">",
                        "0"
                      ]
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "SetSoundChannelVolume"
                      },
                      "parameters": [
                        "",
                        "100",
                        "=",
                        "clamp(SoundChannelVolume(100)-3,0,100)"
                      ]
                    }
                  ]
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "SoundChannelVolume"
                      },
                      "parameters": [
                        "",
                        "100",
                        "<=",
                        "0"
                      ]
                    },
                    {
                      "type": {
                        "value": "BuiltinCommonInstructions::Once"
                      },
                      "parameters": []
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "SetNumberVariable"
                      },
                      "parameters": [
                        "GameState.GameOver",
                        "=",
                        "1"
                      ]
                    },
                    {
                      "type": {
                        "value": "PlaySoundOnChannel"
                      },
                      "parameters": [
                        "",
                        "Jonathan_So-FallenInBattle.ogg",
                        "0",
                        "",
                        "100",
                        "1"
                      ]
                    }
                  ]
                },
                {
                  "type": "BuiltinCommonInstructions::Comment",
                  "color": {
                    "b": 109,
                    "g": 230,
                    "r": 255,
                    "textB": 0,
                    "textG": 0,
                    "textR": 0
                  },
                  "comment": "Start fading in the FadeObject sprite and GameOver text using a tween."
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "BuiltinCommonInstructions::Once"
                      },
                      "parameters": []
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "Tween::AddObjectOpacityTween"
                      },
                      "parameters": [
                        "FadeObject",
                        "Tween",
                        "\"DeathFadeIn\"",
                        "255",
                        "\"linear\"",
                        "500",
                        ""
                      ]
                    },
                    {
                      "type": {
                        "value": "Tween::AddObjectOpacityTween"
                      },
                      "parameters": [
                        "BitmapGameOver",
                        "Tween",
                        "\"GameOverFadeIn\"",
                        "255",
                        "\"linear\"",
                        "500",
                        ""
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "parameters": []
        },
        {
