                      },
                      "parameters": [
                        "Hero",
                        "hasDashed",
                        "=",
                        "0"
                      ]
                    }
                  ]
                }
              ],
              "parameters": []
            },
            {
              "colorB": 228,
              "colorG": 176,
              "colorR": 74,
