    {
      "associatedLayout": "Stage",
      "name": "HeroFSMAttack",
      "events": [
        {
          "colorB": 228,
          "colorG": 176,
          "colorR": 74,
          "creationTime": 0,
          "name": "Actions",
          "source": "",
          "type": "BuiltinCommonInstructions::Group",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "The initial actions will help set the animation, ensure that attacking can only occur once, even in the same state, by setting a hasAttacked variable, and play the sword sound effect."
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "NumberObjectVariable"
                  },
                  "parameters": [
                    "Hero",
                    "hasAttacked",
                    "=",
                    "0"
                  ]
                },
                {
                  "type": {
                    "value": "BuiltinCommonInstructions::Once"
                  },
                  "parameters": []
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "AnimatableCapability::AnimatableBehavior::SetName"
                  },
                  "parameters": [
                    "Hero",
                    "Animation",
                    "=",
                    "\"Attack\""
                  ]
                },
                {
                  "type": {
                    "value": "SetNumberObjectVariable"
                  },
                  "parameters": [
                    "Hero",
                    "hasAttacked",
                    "=",
                    "1"
                  ]
                },
                {
                  "type": {
                    "value": "PlaySoundOnChannel"
                  },
                  "parameters": [
                    "",
                    "sword sound.wav",
                    "5",
                    "",
                    "100",
                    "1"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "To avoid spamming any of the jumps, dashes, or attacks, require the player to release the key or button before they can be used again."
            },
            {
              "colorB": 228,
              "colorG": 176,
              "colorR": 74,
              "creationTime": 0,
              "name": "Can only dash once",
              "source": "",
              "type": "BuiltinCommonInstructions::Group",
              "events": [
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "inverted": true,
                        "value": "Gamepads::C_Button_pressed"
                      },
                      "parameters": [
                        "",
                        "1",
                        "gamepadDash",
                        ""
                      ]
                    },
                    {
                      "type": {
                        "inverted": true,
