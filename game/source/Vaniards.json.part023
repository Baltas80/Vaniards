                    },
                    {
                      "type": {
                        "value": "BuiltinCommonInstructions::Once"
                      },
                      "parameters": []
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "SetStringObjectVariable"
                      },
                      "parameters": [
                        "PatrollerEnemy",
                        "Direction",
                        "=",
                        "\"Left\""
                      ]
                    },
                    {
                      "type": {
                        "value": "FlippableCapability::FlippableBehavior::FlipX"
                      },
                      "parameters": [
                        "PatrollerEnemy",
                        "Flippable",
                        "no"
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "parameters": []
        }
      ]
    },
    {
      "associatedLayout": "Stage",
      "name": "DelayedChaseEnemy",
      "events": [
        {
          "type": "BuiltinCommonInstructions::Comment",
          "color": {
            "b": 109,
            "g": 230,
            "r": 255,
            "textB": 0,
            "textG": 0,
            "textR": 0
          },
          "comment": "A delayed chase enemy is an enemy that spawns in, then chases the player after a determined delay.\nWhile you can apply the same logic to a group of enemies, since this has some custom animations for the Ghost it is being specifically identified in these events."
        },
        {
          "colorB": 228,
          "colorG": 176,
          "colorR": 74,
          "creationTime": 0,
          "name": "Delayed Chase Ghost",
          "source": "",
          "type": "BuiltinCommonInstructions::Group",
          "events": [
            {
              "colorB": 228,
              "colorG": 176,
              "colorR": 74,
              "creationTime": 0,
              "name": "Initialization",
              "source": "",
              "type": "BuiltinCommonInstructions::Group",
              "events": [
                {
                  "type": "BuiltinCommonInstructions::Comment",
                  "color": {
                    "b": 109,
                    "g": 230,
                    "r": 255,
                    "textB": 0,
                    "textG": 0,
                    "textR": 0
                  },
                  "comment": "The ghost should be hidden by default so it can appear once the player is in range.\nBy using the Pause Timer action, the timer both created AND paused on the ghost."
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "SceneJustBegins"
                      },
                      "parameters": [
                        ""
                      ]
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "Hide"
                      },
                      "parameters": [
                        "Ghost"
                      ]
                    },
                    {
                      "type": {
                        "value": "PauseObjectTimer"
                      },
                      "parameters": [
                        "Ghost",
                        "\"AttackTimer\""
                      ]
                    }
                  ]
                }
              ],
              "parameters": []
            },
            {
              "colorB": 228,
              "colorG": 176,
              "colorR": 74,
              "creationTime": 0,
              "name": "Main logic",
              "source": "",
              "type": "BuiltinCommonInstructions::Group",
              "events": [
                {
                  "type": "BuiltinCommonInstructions::Comment",
                  "color": {
                    "b": 109,
                    "g": 230,
                    "r": 255,
                    "textB": 0,
                    "textG": 0,
                    "textR": 0
                  },
                  "comment": "Only process the AI Logic if the Ghost is visible."
                },
                {
                  "type": "BuiltinCommonInstructions::ForEach",
                  "object": "Ghost",
                  "conditions": [],
                  "actions": [],
                  "events": [
                    {
                      "type": "BuiltinCommonInstructions::Comment",
                      "color": {
                        "b": 109,
                        "g": 230,
                        "r": 255,
                        "textB": 0,
                        "textG": 0,
                        "textR": 0
                      },
                      "comment": "When the player is in range of the ghost, start it's \"Appear\" animation, and unhide it.\nThe distance is set to 700, or slightly more than half the screen. This is to account for any difference on the Y position.\nEnsure the attack variable is 0, then unpause the attack timer"
                    },
                    {
                      "type": "BuiltinCommonInstructions::Standard",
                      "conditions": [
                        {
                          "type": {
                            "inverted": true,
                            "value": "Visible"
                          },
                          "parameters": [
                            "Ghost"
                          ]
                        },
                        {
                          "type": {
                            "value": "Distance"
                          },
                          "parameters": [
                            "HeroHitbox",
                            "Ghost",
                            "600",
                            ""
                          ]
                        }
                      ],
                      "actions": [
                        {
                          "type": {
                            "value": "AnimatableCapability::AnimatableBehavior::SetName"
                          },
                          "parameters": [
                            "Ghost",
                            "Animation",
                            "=",
                            "\"Appear\""
                          ]
                        },
                        {
                          "type": {
                            "value": "Show"
                          },
                          "parameters": [
                            "Ghost",
                            ""
                          ]
                        },
                        {
                          "type": {
                            "value": "SetNumberObjectVariable"
                          },
                          "parameters": [
                            "Ghost",
                            "Attack",
                            "=",
                            "0"
                          ]
                        },
                        {
                          "type": {
                            "value": "UnPauseObjectTimer"
                          },
                          "parameters": [
                            "Ghost",
                            "\"AttackTimer\""
                          ]
                        }
                      ]
                    },
                    {
                      "type": "BuiltinCommonInstructions::Comment",
                      "color": {
                        "b": 109,
                        "g": 230,
                        "r": 255,
                        "textB": 0,
                        "textG": 0,
                        "textR": 0
                      },
                      "comment": "Process the rest of the events only if the ghost is not hidden."
                    },
                    {
                      "type": "BuiltinCommonInstructions::Standard",
                      "conditions": [
                        {
                          "type": {
                            "value": "Visible"
                          },
                          "parameters": [
                            "Ghost"
                          ]
                        }
                      ],
                      "actions": [],
                      "events": [
                        {
                          "type": "BuiltinCommonInstructions::Comment",
                          "color": {
                            "b": 109,
                            "g": 230,
                            "r": 255,
                            "textB": 0,
                            "textG": 0,
                            "textR": 0
                          },
                          "comment": "If the ghost is not idling, and the animation is finished, set the ghost to the idle animation."
                        },
                        {
                          "type": "BuiltinCommonInstructions::Standard",
                          "conditions": [
                            {
                              "type": {
                                "value": "AnimatableCapability::AnimatableBehavior::HasAnimationEnded"
                              },
                              "parameters": [
                                "Ghost",
                                "Animation"
                              ]
                            },
                            {
                              "type": {
                                "inverted": true,
                                "value": "AnimatableCapability::AnimatableBehavior::Name"
                              },
                              "parameters": [
                                "Ghost",
                                "Animation",
                                "=",
                                "\"GhostIdle\""
                              ]
                            }
                          ],
                          "actions": [
                            {
                              "type": {
                                "value": "AnimatableCapability::AnimatableBehavior::SetName"
                              },
                              "parameters": [
                                "Ghost",
                                "Animation",
                                "=",
                                "\"GhostIdle\""
                              ]
                            }
                          ]
                        },
                        {
                          "type": "BuiltinCommonInstructions::Comment",
                          "color": {
                            "b": 109,
                            "g": 230,
                            "r": 255,
                            "textB": 0,
                            "textG": 0,
                            "textR": 0
                          },
                          "comment": "If the ghost is not currently attacking, the player is in range of the ghost, AND the ghost is currently idling:\nReset the attack timer, then set the ghost to its Attack state by setting the Attack variable to 1."
                        },
                        {
                          "type": "BuiltinCommonInstructions::Standard",
                          "conditions": [
                            {
                              "type": {
                                "value": "NumberObjectVariable"
                              },
                              "parameters": [
                                "Ghost",
                                "Attack",
                                "=",
                                "0"
                              ]
                            },
                            {
                              "type": {
                                "value": "Distance"
                              },
                              "parameters": [
                                "HeroHitbox",
                                "Ghost",
                                "500",
                                ""
                              ]
                            },
                            {
                              "type": {
                                "value": "AnimatableCapability::AnimatableBehavior::Name"
                              },
                              "parameters": [
                                "Ghost",
                                "Animation",
                                "=",
                                "\"GhostIdle\""
                              ]
                            }
                          ],
                          "actions": [
                            {
                              "type": {
                                "value": "ResetObjectTimer"
                              },
                              "parameters": [
                                "Ghost",
                                "\"AttackTimer\""
                              ]
                            },
                            {
                              "type": {
                                "value": "SetNumberObjectVariable"
                              },
                              "parameters": [
                                "Ghost",
                                "Attack",
                                "=",
                                "1"
                              ]
                            }
                          ]
                        },
                        {
                          "type": "BuiltinCommonInstructions::Comment",
                          "color": {
                            "b": 109,
                            "g": 230,
                            "r": 255,
                            "textB": 0,
                            "textG": 0,
                            "textR": 0
                          },
                          "comment": "Only complete the following actions if the ghost is in the attack state."
                        },
                        {
                          "type": "BuiltinCommonInstructions::Standard",
                          "conditions": [
                            {
                              "type": {
                                "value": "NumberObjectVariable"
                              },
                              "parameters": [
                                "Ghost",
                                "Attack",
                                "=",
                                "1"
                              ]
                            }
                          ],
                          "actions": [],
                          "events": [
                            {
                              "type": "BuiltinCommonInstructions::Comment",
                              "color": {
                                "b": 109,
                                "g": 230,
                                "r": 255,
                                "textB": 0,
                                "textG": 0,
                                "textR": 0
                              },
                              "comment": "After a short period of time, record the angle between the ghost's location and the player's location."
                            },
                            {
                              "type": "BuiltinCommonInstructions::Standard",
                              "conditions": [
                                {
                                  "type": {
                                    "inverted": true,
                                    "value": "ObjectTimer"
                                  },
                                  "parameters": [
                                    "Ghost",
                                    "\"AttackTimer\"",
                                    "0.6"
                                  ]
                                }
                              ],
                              "actions": [
                                {
                                  "type": {
                                    "value": "SetNumberObjectVariable"
                                  },
                                  "parameters": [
                                    "Ghost",
                                    "TargetAngle",
                                    "=",
                                    "AngleBetweenPositions(Ghost.CenterX(), Ghost.CenterY(), HeroHitbox.CenterX(), HeroHitbox.CenterY())"
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "BuiltinCommonInstructions::Comment",
                              "color": {
                                "b": 109,
                                "g": 230,
                                "r": 255,
                                "textB": 0,
                                "textG": 0,
                                "textR": 0
                              },
                              "comment": "Start the attack animation."
                            },
                            {
                              "type": "BuiltinCommonInstructions::Standard",
                              "conditions": [
                                {
                                  "type": {
                                    "inverted": true,
                                    "value": "AnimatableCapability::AnimatableBehavior::Name"
                                  },
                                  "parameters": [
                                    "Ghost",
                                    "Animation",
                                    "=",
                                    "\"GhostAttack\""
                                  ]
                                },
                                {
                                  "type": {
                                    "value": "ObjectTimer"
                                  },
                                  "parameters": [
                                    "Ghost",
                                    "\"AttackTimer\"",
                                    "0.6"
                                  ]
                                },
                                {
                                  "type": {
                                    "inverted": true,
                                    "value": "ObjectTimer"
                                  },
                                  "parameters": [
                                    "Ghost",
                                    "\"AttackTimer\"",
                                    "0.7"
                                  ]
                                }
                              ],
                              "actions": [
                                {
                                  "type": {
                                    "value": "AnimatableCapability::AnimatableBehavior::SetName"
                                  },
                                  "parameters": [
                                    "Ghost",
                                    "Animation",
                                    "=",
                                    "\"GhostAttack\""
                                  ]
                                }
                              ],
                              "events": [
                                {
                                  "type": "BuiltinCommonInstructions::Comment",
                                  "color": {
                                    "b": 109,
                                    "g": 230,
                                    "r": 255,
                                    "textB": 0,
                                    "textG": 0,
                                    "textR": 0
                                  },
                                  "comment": "As part of the attack, compare the ghost's position to the player's and flip the sprite if necessary.\ni.e. If the ghost's X position is greater than the player's, they are to the right of the player, and should be facing left (unflipped). If the ghost's X position is less than the player's, they are to the left of the player, and should be facing right (flipped)."
                                },
                                {
                                  "type": "BuiltinCommonInstructions::Standard",
                                  "conditions": [
                                    {
                                      "type": {
                                        "value": "PosX"
                                      },
                                      "parameters": [
                                        "Ghost",
                                        ">",
                                        "HeroHitbox.X()"
                                      ]
                                    }
                                  ],
                                  "actions": [
                                    {
                                      "type": {
                                        "value": "FlippableCapability::FlippableBehavior::FlipX"
                                      },
                                      "parameters": [
                                        "Ghost",
                                        "Flippable",
                                        "no"
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "type": "BuiltinCommonInstructions::Standard",
                                  "conditions": [
                                    {
                                      "type": {
                                        "value": "PosX"
                                      },
                                      "parameters": [
                                        "Ghost",
                                        "<",
                                        "HeroHitbox.X()"
                                      ]
                                    }
                                  ],
                                  "actions": [
                                    {
                                      "type": {
                                        "value": "FlippableCapability::FlippableBehavior::FlipX"
                                      },
                                      "parameters": [
                                        "Ghost",
                                        "Flippable",
                                        "yes"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "BuiltinCommonInstructions::Comment",
                              "color": {
                                "b": 109,
                                "g": 230,
                                "r": 255,
                                "textB": 0,
                                "textG": 0,
                                "textR": 0
                              },
                              "comment": "After a short delay from recording the angle, push the ghost towards that angle.\nThe delay is added so the player can potentially avoid the ghost's attack, rather than it constantly following the player."
                            },
                            {
                              "type": "BuiltinCommonInstructions::Standard",
                              "conditions": [
                                {
                                  "type": {
                                    "value": "AnimatableCapability::AnimatableBehavior::Name"
                                  },
                                  "parameters": [
                                    "Ghost",
                                    "Animation",
                                    "=",
                                    "\"GhostAttack\""
                                  ]
                                },
                                {
                                  "type": {
                                    "value": "ObjectTimer"
                                  },
                                  "parameters": [
                                    "Ghost",
                                    "\"AttackTimer\"",
                                    "0.7"
                                  ]
                                }
                              ],
                              "actions": [
                                {
                                  "type": {
                                    "value": "AddForceAL"
                                  },
                                  "parameters": [
                                    "Ghost",
                                    "Ghost.TargetAngle",
                                    "400",
                                    ""
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "BuiltinCommonInstructions::Comment",
                          "color": {
                            "b": 109,
                            "g": 230,
                            "r": 255,
                            "textB": 0,
                            "textG": 0,
                            "textR": 0
                          },
                          "comment": "Wait longer before resetting the Attack state."
                        },
                        {
                          "type": "BuiltinCommonInstructions::Standard",
                          "conditions": [
                            {
                              "type": {
                                "value": "ObjectTimer"
                              },
                              "parameters": [
                                "Ghost",
                                "\"AttackTimer\"",
                                "1.7"
                              ]
                            }
                          ],
                          "actions": [
                            {
                              "type": {
                                "value": "SetNumberObjectVariable"
                              },
                              "parameters": [
                                "Ghost",
                                "Attack",
                                "=",
                                "0"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "parameters": []
            }
          ],
          "parameters": []
        }
      ]
    },
    {
      "associatedLayout": "Stage",
      "name": "EnemyCombatManagement",
      "events": [
        {
          "colorB": 228,
          "colorG": 176,
          "colorR": 74,
          "creationTime": 0,
          "name": "Damage to Enemies",
          "source": "",
          "type": "BuiltinCommonInstructions::Group",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "When the hero is in the attack animation and has their sword fully extended, check for collision with the attack hitbox.\nIf in collision, apply damage and activate the HitStun variable and timer.\nAlso set the enemy tint to red."
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "CollisionNP"
                  },
                  "parameters": [
                    "HeroAttackHitbox",
                    "Enemy",
                    "",
                    "",
                    ""
                  ]
                },
                {
                  "type": {
                    "value": "AnimatableCapability::AnimatableBehavior::Name"
                  },
                  "parameters": [
                    "Hero",
                    "Animation",
                    "=",
                    "\"Attack\""
                  ]
                },
                {
                  "type": {
                    "value": "Sprite"
                  },
                  "parameters": [
                    "Hero",
                    ">",
                    "2"
                  ]
                },
                {
                  "type": {
                    "value": "BuiltinCommonInstructions::Once"
                  },
                  "parameters": []
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "SetNumberObjectVariable"
                  },
                  "parameters": [
                    "Enemy",
                    "enemyHP",
                    "-",
                    "Hero.Variable(heroDMG)"
                  ]
                },
                {
                  "type": {
                    "value": "ResetObjectTimer"
                  },
                  "parameters": [
                    "Enemy",
                    "\"Hit\""
                  ]
                },
                {
                  "type": {
                    "value": "SetNumberObjectVariable"
                  },
                  "parameters": [
                    "Enemy",
                    "HitStun",
                    "=",
                    "1"
                  ]
                },
                {
                  "type": {
                    "value": "ChangeColor"
                  },
                  "parameters": [
                    "Enemy",
                    "\"255;0;0\""
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "If currently hit stunned, and the timer is greater than 0.1, change the tint back and disable hitstun."
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "NumberObjectVariable"
                  },
                  "parameters": [
                    "Enemy",
                    "HitStun",
                    "=",
                    "1"
                  ]
                },
                {
                  "type": {
                    "value": "ObjectTimer"
                  },
                  "parameters": [
                    "Enemy",
                    "\"Hit\"",
                    "0.1"
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "ChangeColor"
                  },
                  "parameters": [
                    "Enemy",
                    "\"255;255;255\""
                  ]
                },
                {
                  "type": {
                    "value": "SetNumberObjectVariable"
                  },
                  "parameters": [
                    "Enemy",
                    "HitStun",
                    "=",
                    "0"
                  ]
                }
              ]
            }
          ],
          "parameters": []
        },
        {
          "colorB": 228,
          "colorG": 176,
          "colorR": 74,
          "creationTime": 0,
          "name": "Enemy Death",
          "source": "",
          "type": "BuiltinCommonInstructions::Group",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "When a member of the Enemies group has 0 or less HP, create a death fire object below the enemy, then delete the enemy.\nThe deathfire should be centered on the center of the Enemy. This cannot be done through expressions as EnemyDeathFire.Width() will return 0 until after a single death fire exists in the scene. As the death fire is 176 wide, the event action is set up to move it back 88 pixels from the center of the enemy, which will center the fire on X.\nFor Y, this should be centered on the enemy just like X. Since the fire is 208 pixels tall, we move it up 104 pixels to center the fire on Y.\n"
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "NumberObjectVariable"
                  },
                  "parameters": [
                    "Enemy",
                    "enemyHP",
                    "<=",
                    "0"
                  ]
                },
                {
                  "type": {
                    "value": "BuiltinCommonInstructions::Once"
                  },
                  "parameters": []
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "Create"
                  },
                  "parameters": [
                    "",
                    "EnemyDeathFire",
                    "Enemy.CenterX() - 88",
                    "Enemy.CenterY() - 104",
                    "\"\""
                  ]
                },
                {
                  "type": {
                    "value": "SetZOrder"
                  },
                  "parameters": [
                    "EnemyDeathFire",
                    "=",
                    "Enemy.ZOrder() - 1"
                  ]
                },
                {
                  "type": {
                    "value": "Delete"
                  },
                  "parameters": [
                    "Enemy",
                    ""
                  ]
                }
              ],
              "events": [
                {
                  "type": "BuiltinCommonInstructions::Comment",
                  "color": {
                    "b": 109,
                    "g": 230,
                    "r": 255,
                    "textB": 0,
                    "textG": 0,
                    "textR": 0
                  },
                  "comment": "For normal enemies, a shorter death sound is played than the boss.\nThis is checked by comparing the current object name against the BossSkull object name."
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "BuiltinCommonInstructions::CompareStrings"
                      },
                      "parameters": [
                        "Enemy.ObjectName()",
                        "!=",
                        "BossSkull.ObjectName()"
                      ]
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "PlaySoundOnChannel"
                      },
                      "parameters": [
                        "",
                        "skeletonsfx_exp_short_hard2.wav",
                        "11",
                        "",
                        "80",
                        "1"
                      ]
                    }
                  ]
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "BuiltinCommonInstructions::CompareStrings"
                      },
                      "parameters": [
                        "Enemy.ObjectName()",
                        "=",
                        "BossSkull.ObjectName()"
                      ]
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "PlaySoundOnChannel"
                      },
                      "parameters": [
                        "",
                        "bossdeathsfx_exp_cluster1.wav",
                        "11",
                        "",
                        "80",
                        "1"
                      ]