              "name": "Fade In",
              "source": "",
              "type": "BuiltinCommonInstructions::Group",
              "events": [
                {
                  "type": "BuiltinCommonInstructions::Comment",
                  "color": {
                    "b": 109,
                    "g": 230,
                    "r": 255,
                    "textB": 0,
                    "textG": 0,
                    "textR": 0
                  },
                  "comment": "At the start of the scene, the fade object needs to fade to 0 opacity to create a \"Fade In\" effect.\nThis should be treated as a cutscene when fading in to prevent player/enemy movement."
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "SceneJustBegins"
                      },
                      "parameters": [
                        ""
                      ]
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "SetNumberVariable"
                      },
                      "parameters": [
                        "Cutscene",
                        "=",
                        "1"
                      ]
                    },
                    {
                      "type": {
                        "value": "Tween::AddObjectOpacityTween"
                      },
                      "parameters": [
                        "FadeObject",
                        "Tween",
                        "\"LevelFadeIn\"",
                        "0",
                        "\"linear\"",
                        "500",
                        ""
                      ]
                    }
                  ]
                },
                {
                  "type": "BuiltinCommonInstructions::Comment",
                  "color": {
                    "b": 109,
                    "g": 230,
                    "r": 255,
                    "textB": 0,
                    "textG": 0,
                    "textR": 0
                  },
                  "comment": "Once the fade in is finished, end the cutscene."
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "Tween::HasFinished"
                      },
                      "parameters": [
                        "FadeObject",
                        "Tween",
                        "\"LevelFadeIn\""
                      ]
                    },
                    {
                      "type": {
                        "value": "BuiltinCommonInstructions::Once"
                      },
                      "parameters": []
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "SetNumberVariable"
                      },
                      "parameters": [
                        "Cutscene",
                        "=",
                        "0"
                      ]
                    },
                    {
                      "type": {
                        "value": "Tween::RemoveTween"
                      },
                      "parameters": [
                        "FadeObject",
                        "Tween",
                        "\"FadeIn\""
                      ]
                    }
                  ]
                }
              ],
              "parameters": []
            },
            {
              "colorB": 228,
              "colorG": 176,
              "colorR": 74,
              "creationTime": 0,
              "name": "Boss Cutscene",
              "source": "",
              "type": "BuiltinCommonInstructions::Group",
              "events": [
                {
                  "type": "BuiltinCommonInstructions::Comment",
                  "color": {
                    "b": 109,
                    "g": 230,
                    "r": 255,
                    "textB": 0,
                    "textG": 0,
                    "textR": 0
                  },
                  "comment": "Once the Boss Cutscene starts:\nThe camera starts following the hidden CutsceneCamera object."
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "NumberVariable"
                      },
                      "parameters": [
                        "BossStart",
                        "=",
                        "1"
                      ]
                    },
                    {
                      "type": {
                        "value": "CollisionNP"
                      },
                      "parameters": [
                        "HeroHitbox",
                        "BossRoom",
                        "",
                        "",
                        ""
                      ]
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "CenterCameraOnObject"
                      },
                      "parameters": [
                        "",
                        "CutsceneCamera",
                        "",
                        "\"\"",
                        "0"
                      ]
                    },
                    {
                      "type": {
                        "value": "CenterCameraOnObject"
                      },
                      "parameters": [
                        "",
                        "CutsceneCamera",
                        "",
                        "\"DashEffect\"",
                        "0"
                      ]
                    },
                    {
                      "type": {
                        "value": "CenterCameraOnObject"
                      },
                      "parameters": [
                        "",
                        "CutsceneCamera",
                        "",
                        "\"DeathEffect\"",
                        "0"
                      ]
                    }
                  ],
                  "events": [
                    {
                      "type": "BuiltinCommonInstructions::Comment",
                      "color": {
                        "b": 109,
                        "g": 230,
                        "r": 255,
                        "textB": 0,
                        "textG": 0,
                        "textR": 0
                      },
                      "comment": "The global cutscene state is started via a variable, to ensure the player can't move around while the cutscene is occurring.\nA global checkpoint variable is also activated, to ensure that the player starts before the boss room if they die."
                    },
                    {
                      "type": "BuiltinCommonInstructions::Standard",
                      "conditions": [
                        {
                          "type": {
                            "value": "BuiltinCommonInstructions::Once"
                          },
                          "parameters": []
                        }
                      ],
                      "actions": [
                        {
                          "type": {
                            "value": "SetNumberVariable"
                          },
                          "parameters": [
                            "Cutscene",
                            "=",
                            "1"
                          ]
                        },
                        {
                          "type": {
                            "value": "SetNumberVariable"
                          },
                          "parameters": [
                            "GameState.Checkpoint",
                            "=",
                            "1"
                          ]
                        }
                      ]
                    },
                    {
                      "colorB": 228,
                      "colorG": 176,
                      "colorR": 74,
                      "creationTime": 0,
                      "name": "Boss Cutscene Player Movement",
                      "source": "",
                      "type": "BuiltinCommonInstructions::Group",
                      "events": [
                        {
                          "type": "BuiltinCommonInstructions::Comment",
                          "color": {
                            "b": 109,
                            "g": 230,
                            "r": 255,
                            "textB": 0,
                            "textG": 0,
                            "textR": 0
                          },
                          "comment": "As the Cutscene variable disables player controls, the player needs to be moved right until it is past the barrier object."
                        },
                        {
                          "type": "BuiltinCommonInstructions::Standard",
                          "conditions": [
                            {
                              "type": {
                                "value": "PosX"
                              },
                              "parameters": [
                                "HeroHitbox",
                                "<",
                                "BossRoom.X()+Barrier.Width()"
                              ]
                            }
                          ],
                          "actions": [
                            {
                              "type": {
                                "value": "PlatformBehavior::SimulateRightKey"
                              },
                              "parameters": [
                                "HeroHitbox",
                                "PlatformerObject"
                              ]
                            }
                          ],
                          "events": [
                            {
                              "type": "BuiltinCommonInstructions::Comment",
                              "color": {
                                "b": 109,
                                "g": 230,
                                "r": 255,
                                "textB": 0,
                                "textG": 0,
                                "textR": 0
                              },
                              "comment": "As the player could be dashing or stop moving, check the current animation and force it to Run while the cutscene movement is happening.\nTo prevent any graphical oddities with the dash effect, also force the hero object to be on the base layer."
                            },
                            {
                              "type": "BuiltinCommonInstructions::Standard",
                              "conditions": [
                                {
                                  "type": {
                                    "inverted": true,
                                    "value": "AnimatableCapability::AnimatableBehavior::Name"
                                  },
                                  "parameters": [
                                    "Hero",
                                    "Animation",
                                    "=",
                                    "\"Run\""
                                  ]
                                },
                                {
                                  "type": {
                                    "value": "BuiltinCommonInstructions::Once"
                                  },
                                  "parameters": []
                                }
                              ],
                              "actions": [
                                {
                                  "type": {
                                    "value": "AnimatableCapability::AnimatableBehavior::SetName"
                                  },
                                  "parameters": [
                                    "Hero",
                                    "Animation",
                                    "=",
                                    "\"Run\""
                                  ]
                                },
                                {
                                  "type": {
                                    "value": "ChangeLayer"
                                  },
                                  "parameters": [
                                    "Hero",
                                    "\"\""
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "BuiltinCommonInstructions::Comment",
                          "color": {
                            "b": 109,
                            "g": 230,
                            "r": 255,
                            "textB": 0,
                            "textG": 0,
                            "textR": 0
                          },
                          "comment": "After the cutscene movement is done, move the Hero object back to the idle animation, and flag that the boss hero movement is done as a variable."
                        },
                        {
                          "type": "BuiltinCommonInstructions::Standard",
                          "conditions": [
                            {
                              "type": {
                                "value": "PosX"
                              },
                              "parameters": [
                                "HeroHitbox",
                                ">=",
                                "BossRoom.X()+Barrier.Width()"
                              ]
                            },
                            {
                              "type": {
                                "value": "BuiltinCommonInstructions::Once"
                              },
                              "parameters": []
                            }
                          ],
                          "actions": [
                            {
                              "type": {
                                "value": "AnimatableCapability::AnimatableBehavior::SetName"
                              },
                              "parameters": [
                                "Hero",
                                "Animation",
                                "=",
                                "\"Idle\""
                              ]
                            },
                            {
                              "type": {
                                "value": "SetNumberVariable"
                              },
                              "parameters": [
                                "BossHeroMoveDone",
                                "=",
                                "1"
                              ]
                            }
                          ]
                        }
                      ],
                      "parameters": []
                    },
                    {
                      "colorB": 228,
                      "colorG": 176,
                      "colorR": 74,
                      "creationTime": 0,
                      "name": "Boss Cutscene Camera Movement",
                      "source": "",
                      "type": "BuiltinCommonInstructions::Group",
                      "events": [
                        {
                          "type": "BuiltinCommonInstructions::Comment",
                          "color": {
                            "b": 109,
                            "g": 230,
                            "r": 255,
                            "textB": 0,
                            "textG": 0,
                            "textR": 0
                          },
                          "comment": "After the boss cutscene has started, the CutsceneCamera object's position is tweened to our desired location.\nSInce the game camera now follows this object, it is also moved into the desired location."
                        },
                        {
                          "type": "BuiltinCommonInstructions::Standard",
                          "conditions": [
                            {
                              "type": {
                                "value": "BuiltinCommonInstructions::Once"
                              },
                              "parameters": []
                            }
                          ],
                          "actions": [
                            {
                              "type": {
                                "value": "Tween::AddObjectPositionXTween"
                              },
                              "parameters": [
                                "CutsceneCamera",
                                "Tween",
                                "\"BossSceneCameraX\"",
                                "round(BossRoom.CenterX())-(CutsceneCamera.Width()/2)",
                                "\"linear\"",
                                "1500",
                                ""
                              ]
                            },
                            {
                              "type": {
                                "value": "Tween::AddObjectPositionYTween"
                              },
                              "parameters": [
                                "CutsceneCamera",
                                "Tween",
                                "\"BossSceneCameraY\"",
                                "round(BossRoom.CenterY())-(CutsceneCamera.Height()/2)",
                                "\"linear\"",
                                "2000",
                                ""
                              ]
                            }
                          ]
                        },
                        {
                          "type": "BuiltinCommonInstructions::Comment",
                          "color": {
                            "b": 109,
                            "g": 230,
                            "r": 255,
                            "textB": 0,
                            "textG": 0,
                            "textR": 0
                          },
                          "comment": "After the movement is finished, flag that the Boss Camera Movement is done via a variable."
                        },
                        {
                          "type": "BuiltinCommonInstructions::Standard",
                          "conditions": [
                            {
                              "type": {
                                "value": "Tween::HasFinished"
                              },
                              "parameters": [
                                "CutsceneCamera",
                                "Tween",
                                "\"BossSceneCameraX\""
                              ]
                            },
                            {
                              "type": {
                                "value": "Tween::HasFinished"
                              },
                              "parameters": [
                                "CutsceneCamera",
                                "Tween",
                                "\"BossSceneCameraY\""
                              ]
                            },
                            {
                              "type": {
                                "value": "BuiltinCommonInstructions::Once"
                              },
                              "parameters": []
                            }
                          ],
                          "actions": [
                            {
                              "type": {
                                "value": "SetNumberVariable"
                              },
                              "parameters": [
                                "BossCamDone",
                                "=",
                                "1"
                              ]
                            }
                          ]
                        }
                      ],
                      "parameters": []
                    },
                    {
                      "colorB": 228,
                      "colorG": 176,
                      "colorR": 74,
                      "creationTime": 0,
                      "name": "Boss Cutscene Barrier Movement",
                      "source": "",
                      "type": "BuiltinCommonInstructions::Group",
                      "events": [
                        {
                          "type": "BuiltinCommonInstructions::Comment",
                          "color": {
                            "b": 109,
                            "g": 230,
                            "r": 255,
                            "textB": 0,
                            "textG": 0,
                            "textR": 0
                          },
                          "comment": "Only start moving the barriers after both the Hero and the Camera are done moving."
                        },
                        {
                          "type": "BuiltinCommonInstructions::Standard",
                          "conditions": [
                            {
                              "type": {
                                "value": "NumberVariable"
                              },
                              "parameters": [
                                "BossHeroMoveDone",
                                "=",
                                "1"
                              ]
                            },
                            {
                              "type": {
                                "value": "NumberVariable"
                              },
                              "parameters": [
                                "BossCamDone",
                                "=",
                                "1"
                              ]
                            }
                          ],
                          "actions": [],
                          "events": [
                            {
                              "type": "BuiltinCommonInstructions::Standard",
                              "conditions": [
                                {
                                  "type": {
                                    "value": "BuiltinCommonInstructions::Once"
                                  },
                                  "parameters": []
                                }
                              ],
                              "actions": [
                                {
                                  "type": {
                                    "value": "Tween::AddObjectPositionYTween"
                                  },
                                  "parameters": [
                                    "Barrier",
                                    "Tween",
                                    "\"BossBarrierMoveY\"",
                                    "BossRoom.Y()",
                                    "\"linear\"",
                                    "1800",
                                    ""
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "BuiltinCommonInstructions::Standard",
                              "conditions": [
                                {
                                  "type": {
                                    "value": "Tween::Exists"
                                  },
                                  "parameters": [
                                    "Barrier",
                                    "Tween",
                                    "\"BossBarrierMoveY\""
                                  ]
                                }
                              ],
                              "actions": [],
                              "events": [
                                {
                                  "type": "BuiltinCommonInstructions::Comment",
                                  "color": {
                                    "b": 109,
                                    "g": 230,
                                    "r": 255,
                                    "textB": 0,
                                    "textG": 0,
                                    "textR": 0
                                  },
                                  "comment": "While the barriers are moving, fade out the stage music.\nThis is done using a clamp parameter to make sure it stops at 0 and doesn't cause any issues by going to a negative number."
                                },
                                {
                                  "type": "BuiltinCommonInstructions::Standard",
                                  "conditions": [
                                    {
                                      "type": {
                                        "inverted": true,
                                        "value": "Tween::HasFinished"
                                      },
                                      "parameters": [
                                        "Barrier",
                                        "Tween",
                                        "\"BossBarrierMoveY\""
                                      ]
                                    }
                                  ],
                                  "actions": [
                                    {
                                      "type": {
                                        "value": "SetSoundChannelVolume"
                                      },
                                      "parameters": [
                                        "",
                                        "100",
                                        "=",
                                        "clamp(SoundChannelVolume(100)-0.3,0,100)"
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "type": "BuiltinCommonInstructions::Comment",
                                  "color": {
                                    "b": 109,
                                    "g": 230,
                                    "r": 255,
                                    "textB": 0,
                                    "textG": 0,
                                    "textR": 0
                                  },
                                  "comment": "After the barriers have finished moving, start the boss fight music.\nAlso set the variable to start the boss logic. "
                                },
                                {
                                  "type": "BuiltinCommonInstructions::Standard",
                                  "conditions": [
                                    {
                                      "type": {
                                        "value": "Tween::HasFinished"
                                      },
                                      "parameters": [
                                        "Barrier",
                                        "Tween",
                                        "\"BossBarrierMoveY\""
                                      ]
                                    },
                                    {
                                      "type": {
                                        "value": "BuiltinCommonInstructions::Once"
                                      },
                                      "parameters": []
                                    }
                                  ],
                                  "actions": [
                                    {
                                      "type": {
                                        "value": "PlaySoundOnChannel"
                                      },
                                      "parameters": [
                                        "",
                                        "Johnathan_So-MechaCollection.ogg",
                                        "100",
                                        "yes",
                                        "80",
                                        "1"
                                      ]
                                    },
                                    {
                                      "type": {
                                        "value": "SetNumberVariable"
                                      },
                                      "parameters": [
                                        "BossStart",
                                        "=",
                                        "1"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ],
                      "parameters": []
                    }
                  ]
                }
              ],
              "parameters": []
            }
          ],
          "parameters": []
