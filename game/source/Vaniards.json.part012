          "name": "Mobile Touch Controls",
          "source": "",
          "type": "BuiltinCommonInstructions::Group",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "Touch controls are layered on top of the existing keyboard/gamepad controls. Built-in Mouse/Touch conditions treat touches as held input; separate latches prevent jump, attack and dash from repeating while held."
            },
            {
              "colorB": 228,
              "colorG": 176,
              "colorR": 74,
              "creationTime": 0,
              "name": "Mobile Touch Controls - Position",
              "source": "",
