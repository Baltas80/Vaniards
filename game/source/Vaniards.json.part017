            {
              "colorB": 228,
              "colorG": 176,
              "colorR": 74,
              "creationTime": 0,
              "name": "Jump",
              "source": "",
              "type": "BuiltinCommonInstructions::Group",
              "events": [
                {
                  "type": "BuiltinCommonInstructions::Comment",
                  "color": {
                    "b": 109,
                    "g": 230,
                    "r": 255,
                    "textB": 0,
                    "textG": 0,
                    "textR": 0
                  },
                  "comment": "Player can only jump normally if:\nThe jump button has been released since the last dash.\nThe player is on the floor.\nThe jump button or key is pressed."
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "NumberObjectVariable"
                      },
                      "parameters": [
                        "Hero",
                        "hasJumped",
                        "=",
                        "0"
                      ]
                    },
                    {
                      "type": {
                        "value": "BuiltinCommonInstructions::Or"
                      },
                      "parameters": [],
                      "subInstructions": [
                        {
                          "type": {
                            "value": "Gamepads::C_Button_pressed"
                          },
                          "parameters": [
                            "",
                            "1",
                            "gamepadJump",
                            ""
                          ]
                        },
                        {
                          "type": {
                            "value": "KeyFromTextPressed"
                          },
                          "parameters": [
                            "",
                            "keyboardJump"
                          ]
                        }
                      ]
                    },
                    {
                      "type": {
                        "value": "PlatformBehavior::IsOnFloor"
                      },
                      "parameters": [
                        "HeroHitbox",
                        "PlatformerObject"
                      ]
                    },
                    {
                      "type": {
                        "value": "BuiltinCommonInstructions::Once"
                      },
                      "parameters": []
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "SetStringObjectVariable"
                      },
                      "parameters": [
                        "Hero",
                        "heroFSM",
                        "=",
                        "\"Jump\""
                      ]
                    }
                  ]
                },
                {
                  "type": "BuiltinCommonInstructions::Comment",
                  "color": {
                    "b": 109,
                    "g": 230,
                    "r": 255,
                    "textB": 0,
                    "textG": 0,
                    "textR": 0
                  },
                  "comment": "The player can also jump if they have just recently started falling.\nThis is called Coyote Time, and helps with \"Game feel\".\nThis checks that a the CoyoteTime timer is less than a predefined time value. In the events below we're comparing against a Global Variable, so it's easier to change that time later on if needed. \nThe value is set to 0.0833, which is roughly 5 frames.\nThe only difference between this and a normal jump is that we are forcing the jump to occur. This is because the game engine knows the player is falling and shouldn't be allowed to jump.\nBy allowing the player to jump again, and then forcing the jump, this makes it feel like a normal jump has occurred."
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "NumberObjectVariable"
                      },
                      "parameters": [
                        "Hero",
                        "hasJumped",
                        "=",
                        "0"
                      ]
                    },
                    {
                      "type": {
                        "inverted": true,
                        "value": "ObjectTimer"
                      },
                      "parameters": [
                        "HeroHitbox",
                        "\"CoyoteTimer\"",
                        "CoyoteTime"
                      ]
                    },
                    {
                      "type": {
                        "value": "BuiltinCommonInstructions::Or"
                      },
                      "parameters": [],
                      "subInstructions": [
                        {
                          "type": {
                            "value": "Gamepads::C_Button_pressed"
                          },
                          "parameters": [
                            "",
                            "1",
                            "gamepadJump",
                            ""
                          ]
                        },
                        {
                          "type": {
                            "value": "KeyFromTextPressed"
                          },
                          "parameters": [
                            "",
                            "keyboardJump"
                          ]
                        }
                      ]
                    },
                    {
                      "type": {
                        "value": "PlatformBehavior::IsFalling"
                      },
                      "parameters": [
                        "HeroHitbox",
                        "PlatformerObject"
                      ]
                    },
                    {
                      "type": {
                        "value": "BuiltinCommonInstructions::Once"
                      },
                      "parameters": []
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "PlatformBehavior::SetCanJump"
                      },
                      "parameters": [
                        "HeroHitbox",
                        "PlatformerObject"
                      ]
                    },
                    {
                      "type": {
                        "value": "PlatformBehavior::SimulateJumpKey"
                      },
                      "parameters": [
                        "HeroHitbox",
                        "PlatformerObject"
                      ]
                    },
                    {
                      "type": {
                        "value": "SetStringObjectVariable"
                      },
                      "parameters": [
                        "Hero",
                        "heroFSM",
                        "=",
                        "\"Jump\""
                      ]
                    }
                  ]
                }
              ],
              "parameters": []
            },
