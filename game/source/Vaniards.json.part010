          ],
          "events": [
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "If the checkpoint has been reached, start the player at the checkpoint position."
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "NumberVariable"
                  },
                  "parameters": [
                    "GameState.Checkpoint",
                    "=",
                    "1"
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "SetXY"
                  },
                  "parameters": [
                    "HeroHitbox",
                    "=",
                    "Checkpoint.X()",
                    "=",
                    "Checkpoint.Y()"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "Fade Object management\nThis is to stretch the FadeObject to the full screen size and then center it into the middle of the GUI camera.\nSince this object is just a black square, resizing it via events lets it keep a much smaller asset size and not have to worry about memory limits.\nThis object is used whenever there is a need to fade out or in the screen, like for a GameOver or starting the level."
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "SetXY"
                  },
                  "parameters": [
                    "FadeObject",
                    "=",
                    "0",
                    "=",
                    "0"
                  ]
                },
                {
                  "type": {
                    "value": "ResizableCapability::ResizableBehavior::SetHeight"
                  },
                  "parameters": [
                    "FadeObject",
                    "Resizable",
                    "=",
                    "CameraHeight(\"GUI\",0)"
                  ]
                },
                {
                  "type": {
                    "value": "ResizableCapability::ResizableBehavior::SetWidth"
                  },
                  "parameters": [
                    "FadeObject",
                    "Resizable",
                    "=",
                    "CameraWidth(\"GUI\",0)"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "BuiltinCommonInstructions::Comment",
          "color": {
            "b": 109,
            "g": 230,
            "r": 255,
            "textB": 0,
            "textG": 0,
            "textR": 0
          },
          "comment": "The main camera uses a large Camera \"room\" object, and some logic to follow the player in that room. Because the camera could be used in numerous levels, it is stored in an external event sheet.\nMore details are found in the event sheet."
        },
        {
          "type": "BuiltinCommonInstructions::Link",
          "include": {
            "includeConfig": 0
          },
          "target": "CameraManagement"
        },
        {
          "colorB": 228,
          "colorG": 176,
          "colorR": 74,
          "creationTime": 0,
          "name": "Hero Events",
          "source": "",
          "type": "BuiltinCommonInstructions::Group",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "The below event links the Finite State Machine (FSM) for our hero's movement.\nAll hero controls are done in these events, and not in the main event sheet, for many reasons:\n1. Incase we make more levels in the future, this avoids having to remake or copy the events.\n2. A finite state machine will help avoid major conflicts with competing controls.\n\nAdditionally, controls themselves are set up for both keyboard and gamepad. To allow for easier updating of controls, both the gamepad and keyboard conditions utilize global variables for their current settings."
            },
            {
              "type": "BuiltinCommonInstructions::Link",
              "include": {
                "includeConfig": 0
              },
              "target": "HeroFSM"
            },
            {
              "type": "BuiltinCommonInstructions::Link",
              "include": {
                "includeConfig": 0
              },
              "target": "StaminaManagement"
            },
            {
              "type": "BuiltinCommonInstructions::Link",
              "include": {
                "includeConfig": 0
              },
              "target": "HeroObjectManagement"
            }
          ],
          "parameters": []
        },
        {
          "colorB": 228,
          "colorG": 176,
          "colorR": 74,
          "creationTime": 0,
          "name": "GUI Events",
          "source": "",
          "type": "BuiltinCommonInstructions::Group",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Link",
              "include": {
                "includeConfig": 0
              },
              "target": "GUIManagement"
            }
          ],
          "parameters": []
        },
        {
          "colorB": 228,
          "colorG": 176,
          "colorR": 74,
          "creationTime": 0,
          "name": "Enemy Events",
          "source": "",
          "type": "BuiltinCommonInstructions::Group",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "There are 3 different type of normal enemies included, that adhere to many of the standard enemy AI tropes found in games.\nThe wolf enemy is a Dasher, which is an enemy that will start running in the direction it is facing once the player is within range of it.\nThe skeleton enemy is a Patroller, which is an enemy that walks back and forth on a predetermined path, and turns around after colliding with a wall or platform edge.\nThe ghost is a delayed chase enemy, which is an enemy that directly chases the player while they are in range, with a small delay between each movement."
            },
            {
              "type": "BuiltinCommonInstructions::Link",
              "include": {
                "includeConfig": 0
              },
              "target": "DasherEnemy"
            },
            {
              "type": "BuiltinCommonInstructions::Link",
              "include": {
                "includeConfig": 0
              },
              "target": "PatrollerEnemy"
            },
            {
              "type": "BuiltinCommonInstructions::Link",
              "include": {
                "includeConfig": 0
              },
              "target": "DelayedChaseEnemy"
            },
            {
              "type": "BuiltinCommonInstructions::Link",
              "include": {
                "includeConfig": 0
              },
              "target": "EnemyCombatManagement"
            },
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "Most Bosses are scene specific, and there is usually only one. With this in mind, the boss fight events are kept in the scene event sheet instead of as an external event.\nThe boss for the level has a very simple pattern, and only damages the player on contact.\nThe main goal is for the player to realize the boss is too large to jump over, and that dashing through the boss is required to survive.\nThe boss's possible locations are tracked via BossLocation objects. A single object is used for this with a \"Location\" instance variable. This allows for modification of the boss pattern without having to worry about manually tracking specific x/y locations."
            },
            {
              "colorB": 228,
              "colorG": 176,
              "colorR": 74,
              "creationTime": 0,
              "name": "Boss Events",
              "source": "",
              "type": "BuiltinCommonInstructions::Group",
              "events": [
                {
                  "type": "BuiltinCommonInstructions::Comment",
                  "color": {
                    "b": 109,
                    "g": 230,
                    "r": 255,
                    "textB": 0,
                    "textG": 0,
                    "textR": 0
                  },
                  "comment": "Only start the boss fight logic if the BossFightStart variable is set to 1."
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "NumberVariable"
                      },
                      "parameters": [
                        "BossStart",
                        "=",
                        "1"
                      ]
                    }
                  ],
                  "actions": [],
                  "events": [
                    {
                      "type": "BuiltinCommonInstructions::Comment",
                      "color": {
                        "b": 109,
                        "g": 230,
                        "r": 255,
                        "textB": 0,
                        "textG": 0,
                        "textR": 0
                      },
                      "comment": "The BossPhase variable is used to act as a small state machine, to ensure the boss is only doing the desired events during that phase."
                    },
                    {
                      "colorB": 228,
                      "colorG": 176,
                      "colorR": 74,
                      "creationTime": 0,
                      "name": "Initial Boss Phase",
                      "source": "",
                      "type": "BuiltinCommonInstructions::Group",
                      "events": [
                        {
                          "type": "BuiltinCommonInstructions::Standard",
                          "conditions": [
                            {
                              "type": {
                                "value": "NumberObjectVariable"
                              },
                              "parameters": [
                                "BossSkull",
                                "BossPhase",
                                "=",
                                "0"
                              ]
                            }
                          ],
                          "actions": [],
                          "events": [
                            {
                              "type": "BuiltinCommonInstructions::Comment",
                              "color": {
                                "b": 109,
                                "g": 230,
                                "r": 255,
                                "textB": 0,
                                "textG": 0,
                                "textR": 0
                              },
                              "comment": "After the fight starts, the boss should wait a moment before the initial move."
                            },
                            {
                              "type": "BuiltinCommonInstructions::Standard",
                              "conditions": [
                                {
                                  "type": {
                                    "value": "BuiltinCommonInstructions::Once"
                                  },
                                  "parameters": []
                                }
                              ],
                              "actions": [
                                {
                                  "type": {
                                    "value": "UnPauseObjectTimer"
                                  },
                                  "parameters": [
                                    "BossSkull",
                                    "\"MoveTimer\""
                                  ]
                                },
                                {
                                  "type": {
